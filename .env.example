# Copy to .env.local for local work; set the same names in Vercel for production.

# Neon Postgres. On Vercel use the *pooled* connection string (host contains "-pooler").
DATABASE_URL=

# Long random value, e.g.  openssl rand -base64 32
SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image uploads (REQUIRED on Vercel — its filesystem is read-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared rate limiting across all serverless instances (recommended; free tier is enough)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: staff push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: override DB pool size per instance (default 3 on Vercel, 10 elsewhere)
# DB_POOL_MAX=
